# ==================================================
# OSCAR Project .gitignore
# ==================================================

# ------------------
# Local user settings (legacy location; settings now live in the user config folder)
# ------------------
.oscar_settings.json

# ------------------
# Data & Inputs
# ------------------
# Ignore all data by default (to keep large datasets out of Git)
oscar_data/**
!oscar_data/library/
!oscar_data/library/core_data/
!oscar_data/library/core_data/params_precalib/
!oscar_data/library/core_data/params_precalib/**

# ------------------
# Python cache / bytecode
# ------------------
__pycache__/
*.py[cod]

# ------------------
# Environments
# ------------------
.venv/
venv/
.uv/
.env
.env.*
.python-version

# ------------------
# IDE / Editor / OS files
# ------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
.ipynb_checkpoints/

# ------------------
# Build / packaging artifacts
# ------------------
build/
dist/
*.egg-info/

# ------------------
# Tests / coverage (the pytest cache lives in oscar_data/, see pyproject.toml)
# ------------------
.coverage
.coverage.*
htmlcov/

# ------------------
# Logs
# ------------------
*.log
